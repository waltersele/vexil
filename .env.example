# Copia este archivo a .env (no se sube a git) y rellena con los datos de tu hosting.
# Los mismos que usas en FileZilla: servidor, usuario, contraseña y carpeta remota.

FTP_HOST=ftp.tudominio.es
FTP_USER=
FTP_PASSWORD=
# Carpeta del sitio en el servidor (ej. /public_html, /httpdocs, /www)
FTP_REMOTE=/public_html
# Puerto (21 habitual; algunos hostings usan otro)
FTP_PORT=21
# true = FTPS (recomendado). false = FTP sin cifrar
FTP_SECURE=true
# FTP_VERBOSE=true
